        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "topk(10, sum by (login_identifier) (count_over_time({service_name=\"app\"} |= \"Login attempt for\" | regexp \"Login attempt for (?P<login_identifier>[^ ]+)\" [1h])))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Who Tries to Log In (Top 10, Last Hour)",
      "type": "timeseries"
    },
