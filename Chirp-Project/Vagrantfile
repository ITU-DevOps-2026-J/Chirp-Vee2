# -*- mode: ruby -*-
# vi: set ft=ruby :
 
 Vagrant.configure("2") do |config|
   config.vm.box = "bento/ubuntu-22.04"
 
   config.vm.network "private_network", type: "dhcp"
 
   config.vm.provision "file", source: "./", destination: "./"
 
   config.vm.define "dbserver", primary: false do |dbserver|
     dbserver.vm.network "forwarded_port", guest: 5432, host: 1234
     dbserver.vm.provider "virtualbox" do |vb|
       vb.memory = "1024"
     end
     dbserver.vm.hostname = "dbserver"
     dbserver.vm.provision "shell", privileged: true, inline: <<-SHELL
       cd "Chirp-Project"
       ./install-postgresql.sh
     SHELL
   end
     
   config.vm.define "itu-minitwit", primary: true do |server|
     server.vm.network "forwarded_port", guest: 8080, host: 8080
     server.vm.network "forwarded_port", guest: 3000, host: 3000
     server.vm.network "forwarded_port", guest: 9090, host: 9090
     server.vm.provider "virtualbox" do |vb|
       vb.memory = "1024"
     end
     server.vm.hostname = "itu-minitwit"
     server.vm.provision "shell", inline: 'echo "export DOCKER_USERNAME=' + "'" + ENV["DOCKER_USERNAME"] + "'" + '" >> ~/.bash_profile'
     server.vm.provision "shell", inline: 'echo "export DOCKER_ACCESS_TOKEN=' + "'" + ENV["DOCKER_ACCESS_TOKEN"] + "'" + '" >> ~/.bash_profile'
     server.vm.provision "shell", privileged: true, inline: <<-SHELL
     # checks if "$HOME/.bashrc" is already inside "$HOME/.bash_profile" if not then append it the file into it
       if ! grep -q "$(cat $HOME/.bashrc)" $HOME/.bash_profile; then
         echo ". $HOME/.bashrc" >> $HOME/.bash_profile
       fi
          
       source $HOME/.bash_profile
       
       cd "Chirp-Project"
       ./docker-cli.sh
       ./deploy.sh
     SHELL
   end
 end